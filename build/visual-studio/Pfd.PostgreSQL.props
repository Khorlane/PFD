<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PfdPostgreSqlVersion Condition="'$(PfdPostgreSqlVersion)' == ''">16</PfdPostgreSqlVersion>
    <PfdPostgreSqlRoot>$(PfdRoot)external\postgresql\$(PfdPostgreSqlVersion)\windows-x64\</PfdPostgreSqlRoot>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(PfdPostgreSqlRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(PfdPostgreSqlRoot)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>libpq.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(ConfigurationType)' != 'StaticLibrary'">
    <PfdPostgreSqlRuntime Include="$(PfdPostgreSqlRoot)bin\*.dll" />
  </ItemGroup>
  <Target Name="CopyPfdPostgreSqlRuntime" AfterTargets="Build" Condition="'$(ConfigurationType)' != 'StaticLibrary'">
    <Copy SourceFiles="@(PfdPostgreSqlRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
